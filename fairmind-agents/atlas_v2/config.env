# Atlas V2 Environment Configuration
# Copy this file to .env and fill in your actual values

# ===== ANTHROPIC CONFIGURATION =====
# Required: Your Anthropic API key
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# Optional: Specify which Anthropic model to use (default: claude-3-5-sonnet-20241022)
# Available models: claude-3-5-sonnet-20241022, claude-3-haiku-20240307, etc.
DEEPAGENTS_MODEL=anthropic/claude-3-5-sonnet-20241022

# ===== MCP FAIRMIND CONFIGURATION =====
# Required: Your FairMind MCP token for authentication
# This enables access to MCP FairMind tools via LangGraph
MCP_FAIRMIND_TOKEN=your-fairmind-mcp-token-here

# Optional: Override MCP server endpoints if running locally
# MCP_FAIRMIND_BASE_URL=https://project-context.mindstream.fairmind.ai/mcp

# ===== LANGGRAPH CONFIGURATION =====
# Optional: LangSmith tracing for debugging
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here  # Optional for tracing

# Optional: LangGraph Studio configuration
LANGGRAPH_STUDIO=false

# ===== DEVELOPMENT CONFIGURATION =====
# Optional: Enable debug logging
DEBUG=false

# Optional: Set log level
LOG_LEVEL=INFO

# ===== TAVILY CONFIGURATION (if needed) =====
# Optional: For web search functionality (not used in Atlas V2)
# TAVILY_API_KEY=your-tavily-key-here

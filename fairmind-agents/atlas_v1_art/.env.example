# Atlas V1 with OpenPipe ART - ALWAYS ACTIVE
# ==========================================
# OpenPipe ART is ALWAYS ON - no option to disable it
# Every execution is automatically tracked for reinforcement learning

# ==========================================
# REQUIRED: API Keys (at least one)
# ==========================================
# Option 1: OpenRouter (Access to multiple models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet  # or google/gemini-pro-1.5, openai/gpt-4-turbo

# Option 2: Anthropic Direct
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 3: OpenAI Direct  
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# MCP Configuration (Optional but recommended)
# ==========================================
FAIRMIND_MCP_URL=https://project-context.mindstream.fairmind.ai/mcp/mcp/
FAIRMIND_MCP_TOKEN=your_fairmind_token_here

# ==========================================
# OpenPipe ART Trajectory Storage (All Optional - sensible defaults provided)
# ==========================================
ART_PROJECT_NAME=atlas-v1-art              # Project identifier for tracking
ART_TRAJECTORIES_DIR=.art/trajectories     # Where trajectories are saved
ART_MAX_SIZE_MB=500                        # Max storage before rotation
ART_MAX_AGE_DAYS=30                        # Auto-delete old trajectories
ART_COMPRESS_AFTER_DAYS=7                  # Compress old files

# Future: Automatic upload to OpenPipe cloud
ART_AUTO_UPLOAD=false                      # Upload trajectories to OpenPipe
ART_BATCH_SIZE=10                          # Batch size for uploads
OPENPIPE_API_KEY=your_openpipe_key         # If using OpenPipe cloud

# ==========================================
# Model Configuration
# ==========================================
ATLAS_MODEL_NAME=claude-3-5-sonnet-20241022
ATLAS_MODEL_TEMPERATURE=0.7
ATLAS_MODEL_MAX_TOKENS=8192

# ==========================================
# Notes
# ==========================================
# 1. ART is ALWAYS active - no configuration needed
# 2. Trajectories saved to .art/trajectories/
# 3. Use train_with_art.py to train on trajectories
# 4. Storage automatically managed with rotation
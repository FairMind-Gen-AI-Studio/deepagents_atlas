# ArchQA Agent Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: LLM API Key
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# REQUIRED: MCP FairMind Configuration
# =============================================================================
# These are used by langgraph.json to connect to the MCP FairMind server
FAIRMIND_MCP_URL=https://project-context.mindstream.fairmind.ai/mcp/mcp/
FAIRMIND_MCP_TOKEN=your_fairmind_token_here

# =============================================================================
# OPTIONAL: Web Search (Tavily)
# =============================================================================
# If not set, ArchQA will run without web research capability
# The agent will still work using only MCP codebase analysis
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# OPTIONAL: Model Configuration
# =============================================================================
# Uncomment to override default model settings
# ARCHQA_MODEL_NAME=claude-sonnet-4-20250514
# ARCHQA_MODEL_TEMPERATURE=0.7
# ARCHQA_MODEL_MAX_TOKENS=8192

# =============================================================================
# OPTIONAL: LangSmith Tracing (for debugging)
# =============================================================================
# Uncomment to enable LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=archqa
# LANGCHAIN_API_KEY=your_langsmith_key_here
